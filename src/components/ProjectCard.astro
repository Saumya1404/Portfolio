---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
---

<article
  class={`flex flex-col rounded-xl border border-line bg-panel p-6 transition duration-200 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5 ${compact ? 'gap-2' : 'gap-3'}`}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class={`font-semibold text-white ${compact ? 'text-base' : 'text-lg'}`}>{project.title}</h3>
    <span class="rounded-full bg-accent-dim px-3 py-1 text-xs font-medium text-accent">{project.metric}</span>
  </div>
  <p class={`text-zinc-400 ${compact ? 'text-sm' : 'text-[0.95rem] leading-relaxed'}`}>{project.description}</p>
  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-2">
    <div class="flex flex-wrap gap-1.5">
      {project.tech.map((t) => (
        <span class="rounded bg-ink px-2 py-0.5 text-xs text-zinc-500">{t}</span>
      ))}
    </div>
    <div class="ml-auto flex gap-4 text-sm">
      {project.links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">
          {l.label} ↗
        </a>
      ))}
      {project.note && <span class="text-xs italic text-zinc-500">{project.note}</span>}
    </div>
  </div>
</article>
