---
import type { Project } from '../data/site';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
---

<article
  class={compact
    ? 'grid gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] sm:gap-x-6'
    : 'flex flex-col gap-3 rounded-xl border border-line bg-panel p-5 sm:p-6'}
>
  <div>
    <h3 class:list={['font-semibold text-forest', !compact && 'text-lg']}>{project.title}</h3>
    <p class:list={['mt-1 text-sm font-medium text-accent', !compact && 'w-fit rounded-md bg-accent-dim px-2 py-1']}>{project.metric}</p>
  </div>
  <div>
    <p class="text-sm leading-relaxed text-muted">{project.description}</p>
    {(project.links.length > 0 || project.note) && <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {project.links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">
          {l.label} ↗
        </a>
      ))}
      {project.note && <span class="text-xs italic text-muted">{project.note}</span>}
    </div>}
  </div>
  {!compact && <ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
    {project.tech.map((t) => (
      <li class="rounded border border-line px-2 py-0.5 text-xs text-muted">{t}</li>
    ))}
  </ul>}
</article>
