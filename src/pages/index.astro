---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, about, featured, more, experience, publication, skills } from '../data/site';
---

<Base>
  <!-- Hero -->
  <section class="pt-24 pb-10 sm:pt-32 sm:pb-12">
    <p class="mb-3 text-sm font-medium tracking-widest text-accent uppercase">Portfolio</p>
    <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{profile.name}</h1>
    <p class="mt-4 max-w-2xl text-xl text-zinc-300">{profile.tagline}</p>
    <p class="mt-2 max-w-2xl text-sm text-zinc-500">{profile.sub}</p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm font-medium">
      <a href="#projects" class="rounded-lg bg-accent px-4 py-2 text-ink transition duration-150 hover:scale-105 hover:opacity-90">View projects</a>
      <a href={profile.resume} class="rounded-lg border border-line px-4 py-2 text-zinc-200 transition duration-150 hover:scale-105 hover:border-accent/50">Resume (PDF)</a>
      <a href={profile.github} target="_blank" rel="noopener" class="rounded-lg border border-line px-4 py-2 text-zinc-200 transition duration-150 hover:scale-105 hover:border-accent/50">GitHub</a>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="rounded-lg border border-line px-4 py-2 text-zinc-200 transition duration-150 hover:scale-105 hover:border-accent/50">LinkedIn</a>
      <a href={`mailto:${profile.email}`} class="rounded-lg border border-line px-4 py-2 text-zinc-200 transition duration-150 hover:scale-105 hover:border-accent/50">Email</a>
    </div>
  </section>

  <!-- Featured projects -->
  <section id="projects" class="scroll-mt-20 py-12">
    <h2 class="mb-2 text-2xl font-semibold text-white">Featured work</h2>
    <p class="mb-8 text-sm text-zinc-500">Selected projects in retrieval, agent tooling, and model infrastructure.</p>
    <div class="flex flex-col gap-5">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>

    <h2 class="mt-16 mb-8 text-xl font-semibold text-white">More projects</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((p) => <ProjectCard project={p} compact />)}
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 py-12">
    <h2 class="mb-6 text-2xl font-semibold text-white">About</h2>
    <div class="max-w-3xl space-y-4 leading-relaxed text-zinc-400">
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <p class="text-sm text-zinc-500">
        Dean’s List certificates:
        <a href={about.certificate} target="_blank" rel="noopener" class="text-accent hover:underline">view ↗</a>
      </p>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="scroll-mt-20 py-12">
    <h2 class="mb-8 text-2xl font-semibold text-white">Experience</h2>
    <ol class="relative space-y-10 border-l border-line pl-6">
      {experience.map((e) => (
        <li class="relative">
          <span class="absolute -left-[1.85rem] top-1.5 h-3 w-3 rounded-full border-2 border-accent bg-ink"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-semibold text-white">{e.role} · <span class="text-zinc-300">{e.org}</span></h3>
            <span class="text-sm text-zinc-500">{e.period}</span>
          </div>
          <ul class="mt-2 list-disc space-y-1 pl-4 text-sm leading-relaxed text-zinc-400">
            {e.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- Publication -->
  <section id="publication" class="scroll-mt-20 py-12">
    <h2 class="mb-6 text-2xl font-semibold text-white">Publication</h2>
    <div class="rounded-xl border border-line bg-panel p-6 transition duration-200 ease-out hover:scale-[1.01] hover:border-accent/40">
      <p class="leading-relaxed text-zinc-300">{publication.citation}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm font-medium">
        <a href={publication.url} target="_blank" rel="noopener" class="text-accent hover:underline">IEEE Xplore ↗</a>
        <a href={publication.relatedUrl} target="_blank" rel="noopener" class="text-accent hover:underline">Related public repo ↗</a>
      </div>
      <p class="mt-3 text-xs italic text-zinc-500">{publication.note}</p>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="scroll-mt-20 py-12">
    <h2 class="mb-8 text-2xl font-semibold text-white">Skills</h2>
    <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((s) => (
        <div>
          <h3 class="mb-2 text-sm font-semibold tracking-wide text-zinc-300 uppercase">{s.group}</h3>
          <div class="flex flex-wrap gap-1.5">
            {s.items.map((i) => (
              <span class="rounded border border-line bg-panel px-2 py-1 text-xs text-zinc-400 transition duration-150 hover:scale-110 hover:border-accent/50 hover:text-zinc-200">{i}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-16 text-center">
    <h2 class="text-2xl font-semibold text-white">Get in touch</h2>
    <p class="mx-auto mt-3 max-w-md text-zinc-400">
      Reach out to discuss AI engineering, research, or a project.
    </p>
    <a
      href={`mailto:${profile.email}`}
      class="mt-6 inline-block rounded-lg bg-accent px-6 py-3 font-medium text-ink transition duration-150 hover:scale-105 hover:opacity-90"
    >
      {profile.email}
    </a>
  </section>
</Base>
