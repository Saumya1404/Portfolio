---
import '../styles/global.css';
import { profile } from '../data/site';

const title = `${profile.name} — AI Engineer`;
const description = profile.tagline;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-10 border-b border-line bg-ink/90 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3 text-sm">
        <a href="#top" class="font-semibold tracking-tight text-white">SR</a>
        <div class="hidden gap-5 text-zinc-400 sm:flex">
          <a href="#projects" class="hover:text-accent">Projects</a>
          <a href="#about" class="hover:text-accent">About</a>
          <a href="#experience" class="hover:text-accent">Experience</a>
          <a href="#publication" class="hover:text-accent">Publication</a>
          <a href="#skills" class="hover:text-accent">Skills</a>
          <a href={profile.resume} class="hover:text-accent">Resume</a>
        </div>
        <details class="relative sm:hidden" id="mobile-menu">
          <summary class="cursor-pointer list-none rounded border border-line px-3 py-1.5 text-zinc-300 select-none">
            Menu
          </summary>
          <div class="absolute right-0 mt-2 flex w-44 flex-col gap-1 rounded-lg border border-line bg-panel p-2 text-zinc-300 shadow-xl">
            <a href="#projects" class="rounded px-3 py-2 hover:bg-ink hover:text-accent">Projects</a>
            <a href="#about" class="rounded px-3 py-2 hover:bg-ink hover:text-accent">About</a>
            <a href="#experience" class="rounded px-3 py-2 hover:bg-ink hover:text-accent">Experience</a>
            <a href="#publication" class="rounded px-3 py-2 hover:bg-ink hover:text-accent">Publication</a>
            <a href="#skills" class="rounded px-3 py-2 hover:bg-ink hover:text-accent">Skills</a>
            <a href={profile.resume} class="rounded px-3 py-2 hover:bg-ink hover:text-accent">Resume</a>
          </div>
        </details>
      </nav>
      <script>
        // Close the mobile menu after a link is tapped so it doesn't cover the target section.
        const menu = document.getElementById('mobile-menu');
        menu?.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => menu.removeAttribute('open'))
        );
      </script>
    </header>
    <main id="top" class="mx-auto max-w-5xl px-5">
      <slot />
    </main>
    <footer class="mt-24 border-t border-line py-10 text-center text-sm text-zinc-500">
      <p>
        © {new Date().getFullYear()} {profile.name} ·
        <a href={`mailto:${profile.email}`} class="text-zinc-400 hover:text-accent">{profile.email}</a>
      </p>
    </footer>
  </body>
</html>
